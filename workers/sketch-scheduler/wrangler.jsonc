{
  // byeoli-sketch-scheduler — 그림일기 서버측 크론 (cron-job.org 30초 캡 대체)
  // 배포: 이 폴더에서 `npx wrangler deploy` / 관측: `npx wrangler tail byeoli-sketch-scheduler`
  // 비밀: PUBLISH_KEY (wrangler secret put — Pages 프로젝트와 동일 값)
  "name": "byeoli-sketch-scheduler",
  "main": "index.mjs",
  "compatibility_date": "2026-07-01",
  "triggers": {
    // ⚠ 구조 교체 2026-08-27 (사장 판정 「몇 달을 며칠에 한 번씩 멈추면 그게 무슨 자동화냐」):
    // 「하룻밤 한 창」을 버리고 밤을 7개의 작은 창으로 쪼갠다 — 23:30 본진(오늘 접기) 뒤
    // 00:00~02:30 KST 여섯 창이 같은 일기 날짜(?date=시각-6h)를 이어 그린다. 창마다 4콜만
    // 하고 물러나며, 엔드포인트가 멱등이라 어느 창이든 이어받는다. 완주 책임이 있는 창이 없다.
    "crons": ["30 14 * * *", "0 15 * * *", "30 15 * * *", "0 16 * * *", "30 16 * * *", "0 17 * * *", "30 17 * * *"]
  },
  "observability": { "enabled": true }
}
