{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "byeoli-publish-scheduler",
  "main": "index.mjs",
  "compatibility_date": "2026-08-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "BYEOLI_SOCIAL_DIRECTOR",
        "class_name": "ByeoliSocialDirector"
      }
    ]
  },
  "migrations": [
    {
      "tag": "social-director-v1",
      "new_sqlite_classes": ["ByeoliSocialDirector"]
    }
  ],
  "observability": { "enabled": true }
}
